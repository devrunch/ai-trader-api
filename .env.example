# Regenerated from the keys the code actually reads.
# Validated at startup by src/config/env.validation.ts — MONGODB_URI,
# JWT_SECRET (min 32 chars) and INTERNAL_API_KEY (min 32 chars) are REQUIRED
# when NODE_ENV=production and the service will refuse to boot without them.

NODE_ENV=development
PORT=8000

MONGODB_URI=mongodb://localhost:27017/ai-trader

JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m

# Shared secret for the internal/* service-to-service controllers.
# Must match INTERNAL_API_KEY in ai-trader-signals/.env.
INTERNAL_API_KEY=change-this-to-a-random-string-of-at-least-32-characters

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

FRONTEND_URL=http://localhost:3000
SIGNALS_SERVICE_URL=http://localhost:8001
REDIS_URL=redis://redis:6379/0

# SQS signal ingestion.
# SIGNALS_POLLER_ENABLED starts the in-process long-poll consumer. Set it to
# true ONLY where this process is the sole consumer (Docker/Fargate). Under
# serverless.yml the dedicated sqsConsumer Lambda owns the queue, and running
# both produced duplicate signal documents.
SIGNALS_POLLER_ENABLED=true
SQS_SIGNALS_QUEUE_URL=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Planned work — BrokerModule and NotificationsModule are intentional
# placeholders; no code reads these yet.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Only needed if the daily login is scripted rather than done by hand in a
# browser — ZERODHA_TOTP_SECRET is the base32 secret from enabling TOTP 2FA
# in Kite (shown once), not a 6-digit code.
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=
ANGELONE_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com
